# Cada serviço (backend/, engine/, frontend/) já tem seu próprio .gitignore
# específico de stack — este cobre o que pode aparecer na raiz do repo ou
# escapar daqueles (ex: node_modules criado por engano fora de frontend/backend).
node_modules/
dist/
*.log

# Ambiente local
.env
.env.local

# Rascunhos/planos de sessão, não é entregável do projeto
tmp/

# Editor/OS
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store

