# Cloudflare Pages (LW.2.2 / LW.3.16). Limite do Pages: 2000 caracteres por linha e 100 regras.
#
# A CSP abaixo vale para o app (app.selucra.com.br) e para o staging (staging.selucra.com.br), que
# servem o mesmo build. Por isso `connect-src` e `img-src` listam as duas APIs; o valor real de
# VITE_GATEWAY_URL é embutido no build, então só uma das duas é usada em cada ambiente.
#
# Nenhuma origem externa além das duas APIs: sem script, iframe ou imagem de terceiro.
# Sem 'unsafe-eval' e sem script inline: o build não usa nenhum dos dois. 'unsafe-inline' só em
# style-src, porque o React usa o atributo style.
# Fontes são locais (LW.2.5); o service worker precisa de worker-src 'self'.

/*
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https://api.selucra.com.br https://api-staging.selucra.com.br; font-src 'self'; connect-src 'self' https://api.selucra.com.br https://api-staging.selucra.com.br; frame-src 'none'; worker-src 'self'; manifest-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; upgrade-insecure-requests
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), usb=(), bluetooth=(), serial=()
  Strict-Transport-Security: max-age=31536000
  X-Robots-Tag: noindex, nofollow

# O HTML nunca fica em cache longo: o navegador precisa ver o index.html novo para achar os assets novos.
/
  Cache-Control: no-cache

/index.html
  Cache-Control: no-cache

# O service worker e o manifest nunca ficam em cache longo: o navegador precisa ver a versão nova a cada visita.
/sw.js
  Cache-Control: no-cache
  Service-Worker-Allowed: /

/manifest.webmanifest
  Cache-Control: no-cache

/offline.html
  Cache-Control: no-cache

# Arquivos com hash no nome nunca mudam de conteúdo.
/assets/*
  Cache-Control: public, max-age=31536000, immutable
