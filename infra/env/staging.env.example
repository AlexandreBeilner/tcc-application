# Modelo do `.env` de STAGING (/opt/selucra/staging.env, modo 600). Nada é compartilhado com produção:
# senhas, JWT_SECRET e SIMULATION_SEED próprios. Pode ficar desligado fora das validações.

REGISTRY_PREFIX=ghcr.io/alexandrebeilner/selucra
IMAGE_TAG=<sha-do-commit>

DEPLOY_ENV=staging
BACKEND_ALIAS=backend-staging
FRONTEND_URL=https://staging.selucra.com.br
PUBLIC_API_URL=https://api-staging.selucra.com.br

POSTGRES_PASSWORD=<hex-48-diferente-da-producao>
DB_OWNER_PASSWORD=<hex-48-diferente-da-producao>
GAMIFICATION_APP_PASSWORD=<hex-48-diferente-da-producao>
MARKET_APP_PASSWORD=<hex-48-diferente-da-producao>
REDIS_PASSWORD=<hex-48-diferente-da-producao>
SIMULATION_SEED=<outro-inteiro>
JWT_SECRET=<base64-48-diferente-da-producao>

# E-mail só em log (nunca para usuário real); cobrança em sandbox do RevenueCat (chave `rcb_sb_`/`sk_` de teste).
EMAIL_PROVIDER=log
BILLING_PROVIDER=revenuecat
REVENUECAT_SECRET_KEY=<chave-sandbox>
REVENUECAT_WEBHOOK_AUTH=<segredo-sandbox>
REVENUECAT_ENTITLEMENT_ID=<id>

GOOGLE_CLIENT_ID=<...>
GOOGLE_CLIENT_SECRET=<...>
GOOGLE_REDIRECT_URI=https://api-staging.selucra.com.br/auth/google/callback

# --- Recursos reduzidos: staging cabe em ~700 MB e deixa o resto para produção ---
POSTGRES_MEM_LIMIT=256m
POSTGRES_CPUS=0.5
REDIS_MEM_LIMIT=64m
REDIS_MAXMEMORY=48mb
REDIS_CPUS=0.2
ENGINE_MEM_LIMIT=160m
ENGINE_GOMEMLIMIT=128MiB
ENGINE_CPUS=0.3
BACKEND_MEM_LIMIT=256m
BACKEND_HEAP_MB=192
BACKEND_CPUS=0.4
