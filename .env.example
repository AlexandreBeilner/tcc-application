POSTGRES_USER=tcc
POSTGRES_PASSWORD=tcc

# Segredo de assinatura dos JWT emitidos pelo backend (tarefa 1.4). Trocar
# por um valor forte e único fora de ambiente de desenvolvimento.
JWT_SECRET=dev-secret-troque-em-producao

# Credenciais OAuth do Google (console.cloud.google.com > APIs & Services >
# Credentials > OAuth client ID > Web application). Sem elas, /auth/google
# fica indisponível, mas cadastro/login por e-mail continuam funcionando.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback

# URL do frontend local, usada só para redirecionar de volta após o login
# via Google (tela 1.1 do inventário).
FRONTEND_URL=http://localhost:5173

# Usados apenas ao rodar `npm run db:seed:admin` manualmente dentro do
# container do backend — nunca lidos pela aplicação em runtime normal.
# role=admin só existe por este caminho (RNF07), nunca por autocadastro.
# ADMIN_EMAIL=admin@example.com
# ADMIN_PASSWORD=troque-esta-senha
# ADMIN_NAME=Administrador
# ADMIN_USERNAME=admin

# --- Produção (LW.3.8) ---------------------------------------------------
# Com DEPLOY_ENV=production o backend RECUSA subir se qualquer destes estiver
# com valor de desenvolvimento. Em desenvolvimento deixe vazio (ou "development").
# O compose de produção (LW.3.7) não terá valores padrão: tudo abaixo é obrigatório.
# DEPLOY_ENV=production
# Staging (validação no mesmo VPS): DEPLOY_ENV=staging, mesmas exigências, mas aceita EMAIL_PROVIDER=log.
# JWT_SECRET=<32+ caracteres aleatórios, ex: openssl rand -base64 48>
# EMAIL_UNSUBSCRIBE_SECRET=<32+ caracteres, opcional; vazio reaproveita o JWT_SECRET>
# EMAIL_PROVIDER=resend
# Uma chave "Sending access" por subdomínio verificado no Resend (cada uma só envia do seu domínio).
# transactional (send): recuperação de senha, verificação, avisos de segurança, cobrança.
# news (news): e-mails opcionais (opt-in): pedido de amizade, lembrete de sequência, resumo semanal.
# RESEND_API_KEY_TRANSACTIONAL=
# RESEND_API_KEY_NEWS=
# EMAIL_FROM_TRANSACTIONAL=Selucra <no-reply@send.selucra.com.br>
# EMAIL_FROM_NEWS=Selucra <no-reply@news.selucra.com.br>
# EMAIL_REPLY_TO=suporte@selucra.com.br
# RESEND_WEBHOOK_SECRET=
# FRONTEND_URL=https://selucra.com.br
# PUBLIC_API_URL=https://api.selucra.com.br
# GOOGLE_REDIRECT_URI=https://api.selucra.com.br/auth/google/callback
# A Assembleia de Acionistas nasce LIGADA (esquecer a variável não a desliga). Só "off" desliga, em
# emergência; desligando, desligue também governance_hold_declarations (painel, parâmetros do motor).
# ASSEMBLIES_ENABLED=off
# POSTGRES_PASSWORD=<16+ caracteres, nunca "tcc">
# SIMULATION_SEED=<fixo para sempre: mudar quebra a série determinística (RNF08)>
