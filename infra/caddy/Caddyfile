# Porta de entrada de produção e staging (LW.3.7, decisão LW6: Caddy no lugar do nginx do `gateway/`).
# Cadeia: Cloudflare (nuvem laranja, SSL "Full (strict)") -> este Caddy -> backend. O Caddy escolhe o
# ambiente pelo nome do host; o backend de cada um tem um apelido na rede `selucra-edge`.
#
# Faixas da Cloudflare: https://www.cloudflare.com/ips/ (copiadas em 2026-10-12). Mudam raramente;
# conferir a cada trimestre. IP fora delas NÃO é acreditado quando diz ser a Cloudflare.
{
	email {$ACME_EMAIL}

	servers {
		trusted_proxies static 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32
		client_ip_headers CF-Connecting-IP

		# Contra conexão lenta (slowloris) e cliente pendurado (LW.3.10).
		timeouts {
			read_header 10s
			read_body 30s
			idle 60s
		}
	}
}

# Cabeçalhos e compressão comuns às duas APIs (HSTS é daqui: o backend não o envia, LW.3.10).
(api_defaults) {
	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		-Server
	}
}

# Repasse ao backend com o IP real como único valor de X-Forwarded-For (LW.3.9): o backend confia em
# 1 salto (TRUSTED_PROXY_HOPS=1) e nunca vê um cabeçalho forjado pelo cliente.
(to_backend) {
	reverse_proxy {args[0]} {
		header_up X-Forwarded-For {client_ip}
		header_up -CF-Connecting-IP
		transport http {
			dial_timeout 5s
			response_header_timeout 30s
		}
	}
}

api.selucra.com.br {
	import api_defaults

	# Único corpo grande: upload de avatar (o backend aceita 5 MB).
	handle /me/avatar {
		request_body {
			max_size 6MB
		}
		import to_backend backend-prod:3000
	}

	handle {
		request_body {
			max_size 1MB
		}
		import to_backend backend-prod:3000
	}
}

# Staging: mesmo desenho, fora dos buscadores. Fica desligado fora das validações (502 é esperado).
api-staging.selucra.com.br {
	import api_defaults
	header X-Robots-Tag "noindex, nofollow"

	handle /me/avatar {
		request_body {
			max_size 6MB
		}
		import to_backend backend-staging:3000
	}

	handle {
		request_body {
			max_size 1MB
		}
		import to_backend backend-staging:3000
	}
}
