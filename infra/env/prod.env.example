# Modelo do `.env` de PRODUÇÃO (copiar para /opt/selucra/prod.env, modo 600, dono do usuário de deploy;
# NUNCA no git). Valores `<...>` são segredos ou dados reais a preencher. Lista completa e onde criar cada
# um: `.claude/checklist-contas-e-segredos-producao.md`.
# Gerar senha: openssl rand -hex 24      Gerar JWT_SECRET: openssl rand -base64 48

# --- Imagens (preenchidas pelo deploy.sh, LW.3.15) ---
REGISTRY_PREFIX=ghcr.io/alexandrebeilner/selucra
IMAGE_TAG=<sha-do-commit>

# --- Ambiente ---
DEPLOY_ENV=production
BACKEND_ALIAS=backend-prod
ACME_EMAIL=<seu-email>  # usado por docker-compose.edge.yml
FRONTEND_URL=https://app.selucra.com.br
PUBLIC_API_URL=https://api.selucra.com.br

# --- Banco e Redis ---
POSTGRES_PASSWORD=<hex-48>
# Papéis do banco (LW.3.17): senhas só são lidas na PRIMEIRA inicialização do volume do Postgres.
DB_OWNER_PASSWORD=<hex-48>
GAMIFICATION_APP_PASSWORD=<hex-48>
MARKET_APP_PASSWORD=<hex-48>
REDIS_PASSWORD=<hex-48>
# Imutável depois do primeiro dia (RNF08). Entra no backup do .env.
SIMULATION_SEED=<inteiro-fixo>

# --- Segredos da aplicação ---
JWT_SECRET=<base64-48>
EMAIL_UNSUBSCRIBE_SECRET=<base64-48>

# --- Google (login) ---
GOOGLE_CLIENT_ID=<...>
GOOGLE_CLIENT_SECRET=<...>
GOOGLE_REDIRECT_URI=https://api.selucra.com.br/auth/google/callback

# --- E-mail (Resend) ---
EMAIL_PROVIDER=resend
RESEND_API_KEY_TRANSACTIONAL=<re_...>
RESEND_API_KEY_NEWS=<re_...>
RESEND_WEBHOOK_SECRET=<whsec_...>
EMAIL_FROM_TRANSACTIONAL=<remetente>
EMAIL_FROM_NEWS=<remetente>
EMAIL_REPLY_TO=<reply-to>

# --- Recursos (VPS de 2 vCPU e 4 GB; produção fica com a maior parte). Os valores abaixo já são os padrões. ---
# Soma de produção: 1024+256+512+768+128 = 2688 MB. Sobram ~1,3 GB para o sistema e o staging (~700 MB).
#POSTGRES_MEM_LIMIT=1024m
#REDIS_MEM_LIMIT=256m
#ENGINE_MEM_LIMIT=512m
#BACKEND_MEM_LIMIT=768m

# --- Backup (LW.3.12) ---
# Chaves PÚBLICAS do age (age-keygen): a principal (privada guardada FORA do servidor, com o autor) e a de
# teste (privada neste servidor, só para o teste semanal de restauração). Separadas por vírgula.
BACKUP_AGE_RECIPIENTS=<age1...principal>,<age1...teste>
BACKUP_TEST_IDENTITY_FILE=/opt/selucra/backup-test.agekey
APP_ENV_FILE=/opt/selucra/prod.env
# Cloudflare R2 (bucket privado + token só desse bucket, com Object Read & Write).
BACKUP_REMOTE=r2:<nome-do-bucket>
R2_ENDPOINT=https://<id-da-conta>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=<...>
R2_SECRET_ACCESS_KEY=<...>
# Monitoramento "dead man's switch" (healthchecks.io ou equivalente): um check por rotina.
BACKUP_HEALTHCHECK_URL=<https://hc-ping.com/uuid-do-backup>
RESTORE_TEST_HEALTHCHECK_URL=<https://hc-ping.com/uuid-do-teste>
